# ---------------------------------------------------------------- WORKCODE env
# Copy to `.env` and fill in. NEVER commit the real .env.

ENV=development
SECRET_KEY=replace-with-64-random-chars
DATABASE_URL=postgresql+psycopg2://workcode:replace-with-your-postgres-password@localhost:5432/workcode
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Token lifetimes (minutes / days)
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7

# Private storage for source code, versions, submissions and recordings
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50

# Code execution: local (dev) or docker (production)
RUNNER_MODE=local
RUN_TIMEOUT_SECONDS=10
RUN_MEMORY_MB=256
RUN_CPU_SECONDS=5
RUN_MAX_PROCESSES=32
DOCKER_TERMINAL_IMAGE=workcode-terminal:latest

# Monitoring
AUTO_PAUSE_MINUTES=10
HEARTBEAT_SECONDS=30
RECORDING_RETENTION_DAYS=30

# Audit policy: per_admin (default) or all_admins
AUDIT_VISIBILITY=per_admin

# Google Calendar / Meet (https://console.cloud.google.com → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/meetings/google/callback

# HTTP
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
RATE_LIMIT_PER_MINUTE=240

# --- only used by scripts/init_admins.py ---
ADMIN1_EMAIL=admin1@workcode.local
ADMIN1_USERNAME=admin1
ADMIN1_NAME=Platform Admin One
ADMIN1_PASSWORD=
ADMIN2_EMAIL=admin2@workcode.local
ADMIN2_USERNAME=admin2
ADMIN2_NAME=Platform Admin Two
ADMIN2_PASSWORD=
ADMIN3_EMAIL=admin3@workcode.local
ADMIN3_USERNAME=admin3
ADMIN3_NAME=Platform Admin Three
ADMIN3_PASSWORD=
